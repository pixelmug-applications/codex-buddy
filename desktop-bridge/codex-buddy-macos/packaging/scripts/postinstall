#!/usr/bin/env bash
set -euo pipefail

CONSOLE_USER="$(stat -f '%Su' /dev/console || true)"
if [[ -z "$CONSOLE_USER" || "$CONSOLE_USER" == "root" || "$CONSOLE_USER" == "loginwindow" ]]; then
  exit 0
fi

BIN="/usr/local/bin/pixelmug-codex"
APP="/Applications/PixelMug Codex.app"

# Install user-level Codex hook and LaunchAgent in the active desktop user account.
su -l "$CONSOLE_USER" -c "'$BIN' install --bin '$BIN' --no-start-now" ||
  printf "%s\n" "PixelMug Codex postinstall: could not register the hook or LaunchAgent." >&2
su -l "$CONSOLE_USER" -c "open '$APP'" ||
  printf "%s\n" "PixelMug Codex postinstall: could not open the menu-bar app." >&2

exit 0
