#!/bin/sh
set -eu

printf '%s\n' 'PixelMug Codex preinstall: checking for previous user setup.'

CONSOLE_USER="$(stat -f '%Su' /dev/console || true)"
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != root ] && [ "$CONSOLE_USER" != loginwindow ]; then
  if [ -x /usr/local/bin/pixelmug-codex ]; then
    su -l "$CONSOLE_USER" -c "/usr/local/bin/pixelmug-codex uninstall" ||
      printf "%s\n" "PixelMug Codex preinstall: previous user setup cleanup failed." >&2
  fi
fi

exit 0
